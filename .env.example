# FREAKSHOWTOPUP - PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and set your production values.
# NEVER commit your actual .env file or real secrets to version control.

# -------------------------------------------------------------
# 1. Server Configuration & Security
# -------------------------------------------------------------
NODE_ENV=production
PORT=5000
AUTH_SECRET=
CORS_ORIGIN=https://freakshowtopup.shop

# -------------------------------------------------------------
# 2. Super Administrator Setup (Initial Bootstrap)
# -------------------------------------------------------------
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# -------------------------------------------------------------
# 3. Database Connection (PostgreSQL with Prisma)
# -------------------------------------------------------------
DATABASE_URL=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# -------------------------------------------------------------
# 4. Supplier Auto Top-Up API Integration
# -------------------------------------------------------------
SUPPLIER_API_URL=https://ucapi.ucbot.net
SUPPLIER_API_KEY=
SUPPLIER_API_SECRET=

# -------------------------------------------------------------
# 5. Telegram Admin Notification Bot
# -------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_GROUP_ID=
TELEGRAM_AUTHORIZED_USER_IDS=

# -------------------------------------------------------------
# 6. Google OAuth2 / OpenID Connect Authentication
# -------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -------------------------------------------------------------
# 7. Brand & Domain Information
# -------------------------------------------------------------
SITE_NAME=FREAKSHOWTOPUP
SITE_DOMAIN=freakshowtopup.shop

# -------------------------------------------------------------
# 8. Email / SMTP Notifications (Optional)
# -------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=support@freakshowtopup.shop

